{
  "name": "handwritten-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "build:deploy": "node scripts/check-deployment-env.mjs && npm run typecheck && next build",
    "check:deploy": "node scripts/check-deployment-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/check-deployment-env.test.mjs",
    "test:backend": "node --env-file=.env.local scripts/verify-backend.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
